import subprocess

class SDRService:

    def __init__(self): self.process = None

    def stop(self):
        if self.process:
            self.process.terminate()
            self.process.wait(timeout=2)
            self.process = None

    def tune(self, freq):
        self.stop()

        cmd = [
            "rtl_fm",
            "-f", f"{freq}M",
            "-M", "fm",
            "-s", "48000",
            "-g", "40",
            "-l", "100"
        ]

        self.process = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL
        )

        return True


sdr = SDRService()
